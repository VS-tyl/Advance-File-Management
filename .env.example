# ── Postgres ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=file-manager

# ── Backend ──
# For local dev (no Docker): point to localhost.
# Docker Compose overrides DATABASE_URL via the `environment:` block.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/file-manager
FERNET_SECRET_KEY=your_fernet_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
SQL_ECHO=false

# ── CORS / Trust (local dev defaults) ──
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_CREDENTIALS=true
